# Mira data substrate — local configuration (example).
#
# Copy this file to  private/mira-data.env  (gitignored) and fill in your real
# contact. This file is the standard place for user-specific contact + API keys,
# kept out of tracked files per the repo's private-state boundary.
#
# Format: simple KEY=value, '#' starts a comment. No quotes needed.
# Resolution order: environment variable > MIRA_DATA_CONFIG file >
# private/mira-data.env > ~/.config/mira/mira-data.env
#
#   cp templates/mira-data-config.example private/mira-data.env
#   $EDITOR private/mira-data.env

# --- Contact (required for official-data sources) -------------------------
# SEC's access policy requires a contactable User-Agent to fetch filings /
# companyfacts. Adapters that hit SEC refuse to run under the shipped
# placeholder, so set your REAL email here to enable official-data fetches.
MIRA_CONTACT_EMAIL=you@your-domain.com

# Optional display name placed before the email in the User-Agent.
# MIRA_CONTACT_NAME=Your Name or Org

# Or set the full User-Agent string directly (overrides the two fields above).
# MIRA_HTTP_UA=Your Name you@your-domain.com

# --- Optional API keys (only for keyed sources; not needed for SEC/BLS/Yahoo) -
# FRED_API_KEY=
# BEA_API_KEY=

# --- Optional local Interactive Brokers Gateway / TWS connection -----------
# Keep these in private/mira-data.env or environment variables only.
# Typical ports:
#   7497 = TWS paper trading
#   7496 = TWS live
#   4002 = IB Gateway paper trading
#   4001 = IB Gateway live
# The adapter is read-only and requires optional Python package: ib_insync.
# MIRA_IBKR_HOST=127.0.0.1
# MIRA_IBKR_PORT=4002
# MIRA_IBKR_CLIENT_ID=19
# MIRA_IBKR_CLIENT_ID_AUTO=1
# MIRA_IBKR_CLIENT_ID_RETRIES=5
# MIRA_IBKR_ACCOUNT=
# MIRA_IBKR_PORTFOLIO_ID=ibkr_default
# MIRA_IBKR_READONLY=1
# MIRA_IBKR_MARKET_DATA_TYPE=3
# MIRA_IBKR_EXCHANGE=SMART
# MIRA_IBKR_CURRENCY=USD
# MIRA_IBKR_PRIMARY_EXCHANGE=
# MIRA_IBKR_HIST_DURATION=1 Y
# MIRA_IBKR_HIST_BAR_SIZE=1 day
# MIRA_IBKR_HIST_WHAT=TRADES
# MIRA_IBKR_HIST_USE_RTH=1

# --- Optional local Futu OpenD quote connection ---------------------------
# Keep these in private/mira-data.env or environment variables only.
# The adapter is quote-read-only and requires optional Python package:
# futu-api. It does not create a trade context or place orders.
# Futu symbols are market-prefixed, e.g. US.AAPL, HK.00700, SH.600519.
# If you pass an unprefixed symbol, MIRA_FUTU_DEFAULT_MARKET is prepended.
# MIRA_FUTU_HOST=127.0.0.1
# MIRA_FUTU_PORT=11111
# MIRA_FUTU_DEFAULT_MARKET=US
# MIRA_FUTU_CURRENCY=USD
# MIRA_FUTU_TIMEOUT=10
# MIRA_FUTU_HIST_START=
# MIRA_FUTU_HIST_KTYPE=K_DAY
# MIRA_FUTU_HIST_AUTYPE=QFQ

# --- Optional local Tonghuashun (hithink-finance) A-share connection --------------
# Licensed A-share vendor data read on demand through the hithink-finance CLI
# (`hithink-finance auth login` stores the API key in the CLI credential store;
# never copy the key into this file, tracked files or logs). Only the CLI
# location and timeout belong here. Raw vendor payloads stay in private/ state.
# MIRA_HITHINK_BIN=hithink-finance
# MIRA_HITHINK_TIMEOUT=60

# --- CNINFO A-share disclosure portal (no key, no cookie) ------------------
# Public statutory disclosure index: on-demand single-name reads only, never a
# bulk backfill (DATA_POLICY). Tuning is limited to pacing and the read cap.
# MIRA_CNINFO_TIMEOUT=25
# MIRA_CNINFO_PAGE_SLEEP=0.4
# MIRA_CNINFO_MAX_ITEMS=100

# --- SSE / SZSE margin (融资融券) exchange endpoints (no key) ---------------
# Daily publication, and the two exchanges do not always publish the same day: the
# adapter walks back up to MAX_BACKFILL days and records both the requested and the
# used date. SZSE has no per-name filter and returns the whole market (2105 rows)
# code-sorted, so a single-name read binary-searches the page range, capped by
# MAX_SEARCH_PAGES requests.
# MIRA_MARGIN_MAX_BACKFILL_DAYS=14
# MIRA_MARGIN_MAX_SEARCH_PAGES=12

# --- Investor Q&A platforms (互动易 for Shenzhen, 上证e互动 for Shanghai) ------
# Both are exchange-designated and keyless. 互动易 needs two POSTs per name; e互动
# looks the company uid up by binary-searching its code-sorted directory, then parses
# an HTML fragment, so both caps bound the request count for one on-demand read.
# MIRA_QA_MAX_ITEMS=40
# MIRA_QA_MAX_UID_PAGES=10
# MIRA_QA_MAX_FEED_PAGES=3

# --- CFETS benchmark rates (LPR / Shibor, official, no key) -----------------
# 国家统计局 endpoints answer with an anti-bot page and are documented as out of reach
# for a stdlib adapter; these official fixings are reachable and cover the discount-rate
# side. The vendor ignores out-of-range startDate, so the window is a request hint only
# and the returned dates are what gets recorded.
# MIRA_RATES_MAX_OBSERVATIONS=12
# MIRA_RATES_WINDOW_DAYS=360

# --- A-share ETF options surface (via the hithink-finance CLI) ---------------
# The contracts list has no per-underlying filter and is grouped by underlying with the
# nearest expiry first, so the scan is bounded and selection happens locally. Each
# surfaced contract costs one contract-detail call plus one daily call; open interest and
# implied volatility are not published, so the surface is priced but not an IV surface.
# MIRA_OPTIONS_MAX_CONTRACTS=10
# MIRA_OPTIONS_SCAN_ROWS=200
# MIRA_OPTIONS_QUOTE_DAYS=20

# --- China national accounts (CPI/PPI/GDP/PMI) -------------------------------
# Read from an aggregator relay because the NBS endpoints are anti-bot blocked for a
# stdlib client, so records are stamped L5 and say so. The 1Y window is a request hint:
# the vendor table has no publish timestamp and the retrieval date is the vintage.
# MIRA_MACRO_MAX_OBSERVATIONS=24

# --- National Bureau of Statistics data library (official L2) -----------------
# The 2026-03-27 replacement library: keyless JSON, but a POST body (a GET on the retired
# paths returns an anti-bot page). Catalogue metadata is cached because indicator ids are
# opaque UUIDs and the basis text (口径) only lives in the catalogue endpoint.
# MIRA_NBS_MONTHS=36
# MIRA_NBS_CACHE_DAYS=1

# --- Local live market-data preference ------------------------------------
# Set this only on machines where the local broker/provider connector is
# authorized and reachable. When set to futu_opend, `fetch market_price` and
# technical OHLCV routines prefer Futu OpenD over public delayed aggregators.
# MIRA_MARKET_DATA_DEFAULT_SOURCE=futu_opend
# MIRA_LIVE_MARKET_DATA_SOURCE=futu_opend_local
# MIRA_BROKER_DATA_PRIORITY=futu_opend_local,ibkr_gateway_local
# MIRA_FUTU_ENABLED_MARKETS=US,HK,CN_A_SHARE,SG,JP
# MIRA_FUTU_PERMISSION_NOTES=
